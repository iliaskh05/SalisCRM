    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.3",
