# =============================================================================
# SalisCRM — Configuration (même projet Supabase que pro-extract-hub)
# Copiez ce fichier en `.env` — ne committez JAMAIS de secrets.
# =============================================================================

# URL du projet Supabase (publique)
VITE_SUPABASE_URL=https://agoupyllhisvheuxbyhe.supabase.co

# Clé publishable / anon UNIQUEMENT (jamais service_role)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optionnel — nom affiché
VITE_APP_NAME=SalisCRM

# Active la démonstration locale complète, sans connexion Supabase.
# VITE_DEMO_MODE=true

# Fournisseur e-mail sortant. Laisser vide = préparation uniquement, pas d’envoi SMTP.
# VITE_EMAIL_PROVIDER=
