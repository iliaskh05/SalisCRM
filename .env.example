# =============================================================================
# SalisCRM — configuration front (Vite). Copiez en `.env.local`, ne committez jamais.
# Tout ce qui commence par VITE_ est PUBLIC (intégré au JavaScript du navigateur).
# =============================================================================

# Projet Supabase : production = agoupyllhisvheuxbyhe (partagé avec pro-extract-hub).
# Utilisez un projet de STAGING pour le développement et les tests.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Clé publishable / anon UNIQUEMENT. Jamais la clé service_role / sb_secret_.
VITE_SUPABASE_PUBLISHABLE_KEY=

# production | staging | development
VITE_APP_ENV=development

# Suivi des erreurs (Sentry). Vide = désactivé.
VITE_SENTRY_DSN=

# Nom affiché (optionnel)
VITE_APP_NAME=SalisCRM

# Démo locale complète sans Supabase. NE JAMAIS activer sur un build déployé :
# la démo contourne l'authentification.
# VITE_DEMO_MODE=true

# Envoi d'e-mails (devis). "resend" = envoi réel via l'Edge Function send-document-email
# (à déployer + secrets RESEND_API_KEY / EMAIL_FROM côté Supabase, voir README).
# Vide = le devis peut seulement être marqué « envoyé manuellement ».
VITE_EMAIL_PROVIDER=
